{%
  set penalty_raw = node.field_penalty_numeric.value|default(0)
%}
{%
  set penalty_class = penalty_raw > 1000000 ? 'critical' : (penalty_raw > 100000 ? 'high' : 'medium')
%}

<article class="node node--type-enforcement-case node--full">

  <header class="ciq-node-header">
    <div class="ciq-node-meta-row">
      <span class="ciq-badge ciq-badge--case">Enforcement Action</span>
      {% if node.field_date.value %}
        <span style="font-size:0.8125rem;color:var(--navy-400)">{{ node.field_date.value|date('F j, Y') }}</span>
      {% endif %}
      {% for reg in node.field_regulation_violated %}
        {% if reg.entity %}
          <span class="ciq-badge ciq-badge--regulation">{{ reg.entity.name.value }}</span>
        {% endif %}
      {% endfor %}
      {% if node.field_enforcement_body_ref.entity %}
        <span class="ciq-badge ciq-badge--guidance">{{ node.field_enforcement_body_ref.entity.name.value }}</span>
      {% endif %}
    </div>
    <h1>{{ node.title.value }}</h1>
  </header>

  {% if node.field_penalty_amount.value %}
    <div class="ciq-penalty-banner">
      <div>
        <div class="ciq-penalty-banner__label">Penalty</div>
        <div class="ciq-penalty-large ciq-penalty-large--{{ penalty_class }}">{{ node.field_penalty_amount.value }}</div>
      </div>
      {% if node.field_enforcement_body_ref.entity %}
        <div>
          <div class="ciq-penalty-banner__label">Enforcement Body</div>
          <div class="ciq-penalty-banner__value">{{ node.field_enforcement_body_ref.entity.name.value }}</div>
        </div>
      {% endif %}
      {% if node.field_date.value %}
        <div>
          <div class="ciq-penalty-banner__label">Date</div>
          <div class="ciq-penalty-banner__value" style="font-family:var(--font-mono)">{{ node.field_date.value|date('Y-m-d') }}</div>
        </div>
      {% endif %}
      {% if node.field_industry.entity %}
        <div>
          <div class="ciq-penalty-banner__label">Industry</div>
          <div class="ciq-penalty-banner__value">{{ node.field_industry.entity.name.value }}</div>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if node.field_key_facts.value %}
    <div class="ciq-callout ciq-callout--warning">
      <div class="ciq-callout-title">What Went Wrong</div>
      <div>{{ node.field_key_facts.processed }}</div>
    </div>
  {% endif %}

  {% if node.body.value %}
    <div class="ciq-article-body">
      {{ node.body.processed }}
    </div>
  {% endif %}

  {% if node.field_lessons.value %}
    <div class="ciq-callout">
      <div class="ciq-callout-title">Lessons Learned</div>
      <div>{{ node.field_lessons.processed }}</div>
    </div>
  {% endif %}

  {% if node.field_source_url.uri %}
    <div class="ciq-source-link">
      Source: <a href="{{ node.field_source_url.uri }}" target="_blank" rel="noopener noreferrer">
        Official Enforcement Record ↗
      </a>
    </div>
  {% endif %}

</article>
