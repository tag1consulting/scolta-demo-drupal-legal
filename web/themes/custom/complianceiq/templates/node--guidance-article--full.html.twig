<article class="node node--type-guidance-article node--full">

  <header class="ciq-node-header">
    <div class="ciq-node-meta-row">
      <span class="ciq-badge ciq-badge--guidance">Guidance</span>
      {% if node.field_audience.entity %}
        <span class="ciq-badge" style="background:rgba(15,43,70,0.08);color:var(--navy-700);border:1px solid var(--border-subtle)">
          {{ node.field_audience.entity.name.value }}
        </span>
      {% endif %}
      {% if node.field_difficulty.value %}
        <span class="ciq-badge" style="background:transparent;color:var(--navy-500);border:1px solid var(--border-subtle)">
          {{ node.field_difficulty.value|capitalize }}
        </span>
      {% endif %}
      {% for reg in node.field_regulations_covered %}
        {% if reg.entity %}
          <span class="ciq-badge ciq-badge--regulation">{{ reg.entity.name.value }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <h1>{{ node.title.value }}</h1>
    {% if node.field_last_reviewed.value %}
      <div class="ciq-node-subline">Last reviewed: {{ node.field_last_reviewed.value|date('F j, Y') }}</div>
    {% endif %}
  </header>

  {% if node.field_key_takeaways.value %}
    <div class="ciq-callout">
      <div class="ciq-callout-title">Key Takeaways</div>
      <div>{{ node.field_key_takeaways.processed }}</div>
    </div>
  {% endif %}

  {% if node.body.value %}
    <div class="ciq-article-body">
      {{ node.body.processed }}
    </div>
  {% endif %}

  {% set related = node.field_related_sections %}
  {% if related|length > 0 %}
    <section class="ciq-related-section">
      <h3 class="ciq-section-header">Regulations Referenced</h3>
      {% for ref in related %}
        {% if ref.entity %}
          <div class="ciq-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
              <div>
                {% if ref.entity.field_section_number.value %}
                  <code class="section-ref">{{ ref.entity.field_section_number.value }}</code>
                {% endif %}
                <a href="{{ path('entity.node.canonical', {'node': ref.entity.id()}) }}" class="ciq-card-link" style="margin-left:0.5rem">
                  {{ ref.entity.title.value }}
                </a>
              </div>
              {% if ref.entity.field_regulation.entity %}
                <span class="ciq-badge ciq-badge--regulation">{{ ref.entity.field_regulation.entity.name.value }}</span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

  {% set cases = node.field_related_cases %}
  {% if cases|length > 0 %}
    <section class="ciq-related-section">
      <h3 class="ciq-section-header">Related Enforcement Cases</h3>
      {% for ref in cases %}
        {% if ref.entity %}
          <div class="ciq-card">
            <a href="{{ path('entity.node.canonical', {'node': ref.entity.id()}) }}" class="ciq-card-link">
              {{ ref.entity.title.value }}
            </a>
            {% if ref.entity.field_penalty_amount.value %}
              <span style="margin-left:0.75rem;font-family:var(--font-mono);font-size:0.875rem;color:var(--alert-red)">
                {{ ref.entity.field_penalty_amount.value }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

</article>
