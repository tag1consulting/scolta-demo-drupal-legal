{%
  set classes = ['node', 'node--type-regulation-section', 'node--full']
%}
<article{{ attributes.addClass(classes) }}>

  <header class="ciq-node-header">
    <div class="ciq-node-meta-row">
      {% if node.field_section_number.value %}
        <code class="section-ref">{{ node.field_section_number.value }}</code>
      {% endif %}
      {% if node.field_severity.value %}
        <span class="ciq-badge ciq-badge--{{ node.field_severity.value|lower }}">
          {{ node.field_severity.value }} Severity
        </span>
      {% endif %}
      {% if node.field_regulation.entity %}
        <span class="ciq-badge ciq-badge--regulation">{{ node.field_regulation.entity.name.value }}</span>
      {% endif %}
      {% if node.field_jurisdiction.entity %}
        <span class="ciq-badge ciq-badge--guidance">{{ node.field_jurisdiction.entity.name.value }}</span>
      {% endif %}
    </div>

    <h1>{{ node.title.value }}</h1>

    {% if node.field_enforcement_body.value %}
      <div class="ciq-node-subline">Enforced by: {{ node.field_enforcement_body.value }}</div>
    {% endif %}
    {% if node.field_effective_date.value %}
      <div class="ciq-node-subline">Current as of {{ node.field_effective_date.value|date('F j, Y') }}</div>
    {% endif %}
  </header>

  {% if node.field_plain_summary.value %}
    <div class="ciq-callout">
      <div class="ciq-callout-title">Plain Language Summary</div>
      <div>{{ node.field_plain_summary.processed }}</div>
    </div>
  {% endif %}

  {% if node.body.value %}
    <div class="ciq-regulation-body">
      {{ node.body.processed }}
    </div>
  {% endif %}

  <div class="ciq-action-bar">
    <button class="ciq-export-btn" type="button" onclick="window.print()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
      Print
    </button>
  </div>

  {% set related = node.field_related_sections %}
  {% if related|length > 0 %}
    <section class="ciq-related-section">
      <h3 class="ciq-section-header">Related Sections</h3>
      {% for ref in related %}
        {% if ref.entity %}
          <div class="ciq-card">
            <div style="display:flex;justify-content:space-between;align-items:flex-start">
              <div>
                {% if ref.entity.field_section_number.value %}
                  <code class="section-ref">{{ ref.entity.field_section_number.value }}</code>
                {% endif %}
                <a href="{{ path('entity.node.canonical', {'node': ref.entity.id()}) }}" class="ciq-card-link">
                  {{ ref.entity.title.value }}
                </a>
              </div>
              {% if ref.entity.field_regulation.entity %}
                <span class="ciq-badge ciq-badge--regulation">{{ ref.entity.field_regulation.entity.name.value }}</span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

  {% set guidance = node.field_related_guidance %}
  {% if guidance|length > 0 %}
    <section class="ciq-related-section">
      <h3 class="ciq-section-header">Related Guidance</h3>
      {% for ref in guidance %}
        {% if ref.entity %}
          <div class="ciq-card">
            <a href="{{ path('entity.node.canonical', {'node': ref.entity.id()}) }}" class="ciq-card-link">
              {{ ref.entity.title.value }}
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

  {% set cases = node.field_related_cases %}
  {% if cases|length > 0 %}
    <section class="ciq-related-section">
      <h3 class="ciq-section-header">Related Enforcement Cases</h3>
      {% for ref in cases %}
        {% if ref.entity %}
          <div class="ciq-card">
            <a href="{{ path('entity.node.canonical', {'node': ref.entity.id()}) }}" class="ciq-card-link">
              {{ ref.entity.title.value }}
            </a>
            {% if ref.entity.field_penalty_amount.value %}
              <span style="margin-left:0.75rem;font-family:var(--font-mono);font-size:0.875rem;color:var(--alert-red)">
                {{ ref.entity.field_penalty_amount.value }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

</article>
