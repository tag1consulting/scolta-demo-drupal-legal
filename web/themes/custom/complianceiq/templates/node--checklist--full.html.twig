<article class="node node--type-checklist node--full">

  <header class="ciq-node-header">
    <div class="ciq-node-meta-row">
      <span class="ciq-badge ciq-badge--checklist">Checklist</span>
      {% if node.field_audience.entity %}
        <span class="ciq-badge" style="background:rgba(15,43,70,0.08);color:var(--navy-700);border:1px solid var(--border-subtle)">
          {{ node.field_audience.entity.name.value }}
        </span>
      {% endif %}
      {% if node.field_regulation.entity %}
        <span class="ciq-badge ciq-badge--regulation">{{ node.field_regulation.entity.name.value }}</span>
      {% endif %}
    </div>
    <h1>{{ node.title.value }}</h1>
  </header>

  {% if node.body.value %}
    <div class="ciq-article-body">{{ node.body.processed }}</div>
  {% endif %}

  {% if node.field_checklist_items.value %}
    <div class="ciq-checklist-body">
      {{ node.field_checklist_items.processed }}
    </div>
  {% endif %}

  <div class="ciq-action-bar">
    <button class="ciq-export-btn" type="button" onclick="window.print()">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
      Print
    </button>
  </div>

  {% set related = node.field_related_sections %}
  {% if related|length > 0 %}
    <section class="ciq-related-section">
      <h3 class="ciq-section-header">Regulatory Basis</h3>
      {% for ref in related %}
        {% if ref.entity %}
          <div class="ciq-card">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <div>
                {% if ref.entity.field_section_number.value %}
                  <code class="section-ref">{{ ref.entity.field_section_number.value }}</code>
                {% endif %}
                <a href="{{ path('entity.node.canonical', {'node': ref.entity.id()}) }}" class="ciq-card-link" style="margin-left:0.5rem">
                  {{ ref.entity.title.value }}
                </a>
              </div>
              {% if ref.entity.field_regulation.entity %}
                <span class="ciq-badge ciq-badge--regulation">{{ ref.entity.field_regulation.entity.name.value }}</span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

</article>
