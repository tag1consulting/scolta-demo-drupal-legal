<article class="node node--type-comparison node--full">

  <header class="ciq-node-header">
    <div class="ciq-node-meta-row">
      <span class="ciq-badge ciq-badge--guidance">Comparison</span>
      {% for reg in node.field_regulations_compared %}
        {% if reg.entity %}
          <span class="ciq-badge ciq-badge--regulation">{{ reg.entity.name.value }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <h1>{{ node.title.value }}</h1>
  </header>

  {% if node.body.value %}
    <div class="ciq-article-body">
      {{ node.body.processed }}
    </div>
  {% endif %}

  {% if node.field_comparison_table.value %}
    <div class="ciq-article-body" style="overflow-x:auto">
      {{ node.field_comparison_table.processed }}
    </div>
  {% endif %}

  {% if node.field_key_differences.value %}
    <div class="ciq-callout" style="margin-top:2rem">
      <div class="ciq-callout-title">Key Differences</div>
      <div>{{ node.field_key_differences.processed }}</div>
    </div>
  {% endif %}

</article>
